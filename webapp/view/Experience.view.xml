<l:ResponsiveSplitter defaultPane="default">
  <l:PaneContainer >
  <l:SplitPane requiredParentWidth="600" id="default"> 

    <Panel height="100%" width="auto" class="sapUiResponsiveMargin">
      <f:GridList 
        id="AccentureList"
        items="{Experience>/}">
        <f:customLayout>
          <cssgrid:GridBoxLayout xmlns:cssgrid="sap.ui.layout.cssgrid" boxesPerRowConfig="XL1 L1 M1 S1" />
        </f:customLayout>
        <f:GridListItem type="Active" press="onPress">
          <VBox class="sapUiSmallMargin">
            <layoutData>
              <FlexItemData growFactor="1" shrinkFactor="0" />
            </layoutData>
            <Title text="{Experience>company}" wrapping="true" />
            <Label text="Client - {Experience>client}" wrapping="true" />
            <Label text="Role - {Experience>role}" wrapping="true" />
            <Label text="{Experience>duration}" wrapping="true" />
            <Label text="" width="100%"></Label>
            <HBox>
            <tnt:InfoLabel text="Project Description - " />
            <Text text="{Experience>Project Description}" wrapping="true" />
            </HBox>
            
          </VBox>
        </f:GridListItem>
      </f:GridList>
    </Panel>
  </l:SplitPane>     
  <l:PaneContainer orientation="Vertical" >
				<l:SplitPane requiredParentWidth="600">
					<l:layoutData>
						<l:SplitterLayoutData size="auto"/>
					</l:layoutData>
					<Panel stickyHeader="true" height="" headerText="Experience Details" width="auto" class="sapUiResponsiveMargin">
						<VBox items="{detailsModel>/}" id="fillmedaddy" height="500px" width="auto" class="sapUiSmallMargin">
							<items>
                <VBox>
                  <!-- Main bullet -->
                  <Text text="{= Array.isArray(${detailsModel>}) ? '' : '• ' + ${detailsModel>}}" wrapping="true" />
                  <!-- <Text text="{detailsModel>details}" wrapping="true"></Text> -->
                  <!-- Sub-bullets if it's an array -->
                  <VBox visible="{= Array.isArray(${detailsModel>}) }" items="{detailsModel>/}">
                    <items>
                      <Text text="   ◦ {detailsModel>details}" wrapping="true" />
                    </items>
                  </VBox>
                </VBox>
              </items>
						</VBox>
					</Panel>
				</l:SplitPane>
  </l:PaneContainer> 
  </l:PaneContainer>
</l:ResponsiveSplitter>
</mvc:View>