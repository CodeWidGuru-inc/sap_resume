<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View xmlns:core="sap.ui.core"
          xmlns:f="sap.f"
          controllerName="SapDevPortfolio.controller.Certifications"
          xmlns:mvc="sap.ui.core.mvc"
          xmlns:html="sap.ui.core.HTML"
          xmlns:l="sap.ui.layout"
          xmlns:grid="sap.ui.layout.cssgrid"
          xmlns="sap.m">
    <Panel id="CertificationsList"
           backgroundDesign="Transparent"
           headerText="SAP Certifications"
           class="certificationsPanel">
        <f:GridList id="CertificationsGridList"
                    class=""
                    items="{Certifications>/}">
            <f:customLayout>
                <grid:GridBoxLayout boxMinWidth="10rem"/>
            </f:customLayout>
            <f:GridListItem type="Active"
                            press="onPress">
                <VBox class="sapUiSmallMargin">
                    <layoutData>
                        <FlexItemData growFactor="1"
                                      shrinkFactor="0" />
                    </layoutData>
                    <FlexBox justifyContent="SpaceBetween"
                             alignItems="Center"
                             alignContent="Center"
                             direction="Row"
                             >
                            <Image class="Certifications"
                                   src="{Certifications>path}"/>
                    </FlexBox>
                </VBox>
                
            </f:GridListItem>
        </f:GridList>
    </Panel>
</mvc:View>